generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Clients ----------

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

// ---------- Projects ----------

enum ProjectStatus {
  LEAD
  DESIGN
  QUOTED
  APPROVED
  PRODUCTION
  INSTALLATION
  COMPLETE
  CANCELLED
}

model Project {
  id         String        @id @default(cuid())
  client     Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId   String
  name       String
  status     ProjectStatus @default(LEAD)
  budget     Decimal?      @db.Decimal(12, 2)
  startDate  DateTime?
  targetDate DateTime?

  rooms          Room[]
  quotes         Quote[]
  workOrders     WorkOrder[]
  files          FileAsset[]
  calendarEvents CalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([status])
}

// ---------- Design Specs ----------

model Room {
  id        String        @id @default(cuid())
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  specs     CabinetSpec[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

model CabinetSpec {
  id         String    @id @default(cuid())
  room       Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId     String
  doorStyle  String
  finish     String
  material   Material? @relation(fields: [materialId], references: [id])
  materialId String?
  width      Decimal   @db.Decimal(8, 2)
  height     Decimal   @db.Decimal(8, 2)
  depth      Decimal   @db.Decimal(8, 2)
  hardware   String?
  notes      String?
  version    Int       @default(1)

  createdAt DateTime @default(now())

  @@index([roomId])
  @@index([materialId])
}

// ---------- Materials & Suppliers ----------

enum MaterialType {
  WOOD
  LAMINATE
  COUNTERTOP
  HARDWARE
  FINISH
  OTHER
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  materials Material[]

  createdAt DateTime @default(now())
}

model Material {
  id           String        @id @default(cuid())
  name         String
  type         MaterialType
  unitCost     Decimal       @db.Decimal(10, 2)
  unit         String
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  supplierId   String?
  stockQty     Decimal?      @db.Decimal(10, 2)
  reorderLevel Decimal?      @db.Decimal(10, 2)
  cabinetSpecs CabinetSpec[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([supplierId])
}

// ---------- Quotes ----------

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
}

model Quote {
  id        String          @id @default(cuid())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  version   Int             @default(1)
  status    QuoteStatus     @default(DRAFT)
  lineItems QuoteLineItem[]
  subtotal  Decimal         @db.Decimal(12, 2)
  tax       Decimal         @default(0) @db.Decimal(12, 2)
  total     Decimal         @db.Decimal(12, 2)

  pdfData     Bytes?
  pdfFileName String?
  pdfMimeType String?
  pdfSize     Int?

  paid   Boolean   @default(false)
  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(12, 2)

  @@index([quoteId])
}

// ---------- Production ----------

enum ProductionStage {
  CUTTING
  ASSEMBLY
  FINISHING
  QC
  READY
}

model WorkOrder {
  id         String          @id @default(cuid())
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  stage      ProductionStage @default(CUTTING)
  assignedTo String?
  dueDate    DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([stage])
}

// ---------- Files ----------

model FileAsset {
  id         String   @id @default(cuid())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  url        String
  type       String
  uploadedAt DateTime @default(now())

  @@index([projectId])
}

// ---------- Calendar ----------

enum CalendarEventType {
  MEASUREMENT
  CLIENT_MEETING
  MANUFACTURING_START
  DELIVERY
  INSTALLATION
  OTHER
}

model CalendarEvent {
  id        String            @id @default(cuid())
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String?
  title     String
  type      CalendarEventType @default(OTHER)
  startAt   DateTime
  endAt     DateTime?
  allDay    Boolean           @default(true)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([startAt])
}

// ---------- Users ----------

enum UserRole {
  ADMIN
  SALES
  SHOP
  INSTALLER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
